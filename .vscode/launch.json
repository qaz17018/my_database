{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Active C Test File",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/out/${fileBasenameNoExtension}_debug",
            "args": [],
            "stopAtEntry": true, // 我们依然在入口处暂停
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            // [新增] 下面是专门为WSL准备的路径映射
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build Active Test File for Debugging"
        }
    ]
}