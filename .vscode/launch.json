{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug C Program (Dynamic)",
            "type": "cppdbg",
            "request": "launch",
            // "program" 不再是硬编码，而是使用了输入变量 ${input:testName}
            "program": "${workspaceFolder}/out/${input:testName}_debug",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            // preLaunchTask 现在指向我们新的通用任务
            "preLaunchTask": "Make Debug Build"
        }
    ],
    // "inputs" 是这次改造的核心！
    "inputs": [
        {
            // 定义一个ID为 "testName" 的输入变量
            "id": "testName",
            "type": "promptString",
            "description": "Enter the name of the test file to debug (e.g., test_b_tree_insert)",
            "default": "test_b_tree_insert"
        }
    ]
}