{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Make Debug Build",
            "type": "shell",
            // 命令现在非常通用，只调用 make debug
            // 具体构建哪个文件，由 launch.json 传来的变量决定
            "command": "make debug TEST=${input:testName}",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}